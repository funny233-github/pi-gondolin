{
  // ===== Basic resources =====
  "memory": "6G", // RAM; supports K/M/G suffixes
  "cpus": 8, // CPU cores
  "rootfs": {
    "size": "4G"
  }, // disk size (image needs resize2fs/e2fsprogs-extra)
  // ===== Image (optional) =====
  "sandbox": {
    "imagePath": "workspace:latest"
  }, // image ref / build id / asset dir path
  // ===== SSH egress proxy (optional; requires a host ssh-agent) =====
  "ssh": {
    "allowedHosts": [
      "github.com",
      "*.github.com"
    ], // ssh-allow host whitelist
    "agent": "${SSH_AUTH_SOCK}" // agent socket; ${VAR} is replaced with the host env value at load time
  },
  // ===== Fake-host -> host port mapping (optional; exposes host services to the VM) =====
  // "tcp": { "game-gw:80": "127.0.0.1:8787" },
  // ===== Env vars injected into the VM (optional; these are REAL values, the AI can see them) =====
  "env": {},
  // e.g. "env": { "MODE": "dev", "TOKEN": "${MY_TOKEN}" }
  // ===== Extra mounts (optional) =====
  // Format "hostPath:guestPath"; a bare host path is mounted at /mnt/<basename>; host path must exist
  "mounts": [],
  // e.g. "mounts": ["/home/user/Work:/Work", "/home/user/data"]
  // ===== Pi skills mounts (optional) =====
  // If you use pi skills ( ~/.pi/agent/skills/ ), mount them so the agent can access them:
  // "mounts": [
  //   "/home/user/.pi/agent/skills:/root/.pi/agent/skills",
  // ]
  // Without this, skills will not trigger because the agent cannot find them in the VM.
  // ===== Git identity inheritance (optional; default true) =====
  // The host's user.name / user.email are injected as GIT_AUTHOR_*/GIT_COMMITTER_*
  // so commits inside the VM show your real identity. Set false to disable.
  // "gitIdentity": false,
  // ===== Git-in-VM hardening (optional; recommended) =====
  // git runs inside the VM (as root) against the mounted host repo. Because sandboxfs
  // strips exec bits and forces host ownership, git needs a few tweaks to work cleanly:
  //   safe.directory        -> avoid the "dubious ownership" fatal on the mounted repo
  //   core.fileMode=false   -> ignore exec-bit noise in `git status`/diffs
  //   GIT_TERMINAL_PROMPT=0 -> don't block waiting for input when there's no TTY
  // Inject them via the VM env (GIT_CONFIG_KEY_N/VALUE_N is git's env-based config):
  // "env": {
  //   "GIT_CONFIG_COUNT": "2",
  //   "GIT_CONFIG_KEY_0": "safe.directory",
  //   "GIT_CONFIG_VALUE_0": "*",
  //   "GIT_CONFIG_KEY_1": "core.fileMode",
  //   "GIT_CONFIG_VALUE_1": "false",
  //   "GIT_TERMINAL_PROMPT": "0"
  // },
  // ===== HTTP secret injection (optional; the VM only sees placeholders, real values live in host env) =====
  "secrets": {}
  // e.g.
  // "secrets": {
  //   "GAME_API_KEY": {
  //     "hosts": ["api.game.com"],          // only sent to this host
  //     "valueFromEnv": "GAME_API_KEY"      // real value read from the host env var of the same name
  //   }
  // }
}
